#!/bin/bash
# ultrawide-mode: switch window mode for docked ultrawide use.
#   ultrawide-mode float [bar-width-%]   everything floats; optional width
#                                       also narrows the bar (needs the
#                                       ultrawide-bar plugin + helper)
#   tile  -> dwindle tiling + single-window 1:1 aspect cap; windows floated
#            by this mode are snapped back into the tiles
#   off   -> plain dwindle (undocked laptop default); same snap-back
#   status-> print current mode
# NOTE: hyprmoncfg profile exec is split with shellwords, NOT a shell —
# keep exec strings a single command with plain args (no && or redirects):
#   exec = "ultrawide-mode float 60"
# Windows that were ALREADY floating before 'float' ran (1Password, meeting
# recorder, popups...) are recorded as protected and never touched.
# State lives in ~/.local/state/ultrawide-mode/ (NOT the omarchy toggles dir —
# hyprmoncfgd reconciles that directory and deletes unknown flags on apply).
# ~/.config/hypr/ultrawide-mode.lua sources this dir on every Hyprland reload.

set -u
TOGGLE_DIR="$HOME/.local/state/ultrawide-mode"
FLOAT_FLAG="$TOGGLE_DIR/float-default.lua"
ASPECT_FLAG="$TOGGLE_DIR/single-window-aspect-ratio.lua"
PROTECTED="$TOGGLE_DIR/float-protected.txt"

notify() { omarchy-notification-send -g 󰍜 "Window mode: $1"; }

# Tile -> float: protect current floaters, then float every mapped tiled
# window. Skips fullscreen windows and special workspaces.
# Discover the live Hyprland instance when the env var is missing (daemon
# exec children). Multiple instance dirs can exist (stale sandboxes), so
# probe each newest-first until hyprctl answers.
find_hyprland_sig() {
  local sig
  for sig in $(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/" 2>/dev/null); do
    if HYPRLAND_INSTANCE_SIGNATURE="$sig" timeout 2 hyprctl version >/dev/null 2>&1; then
      printf '%s' "$sig"; return 0
    fi
  done
  return 1
}

sweep_to_float() {
  export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(find_hyprland_sig)}"
  python3 - "$PROTECTED" <<'PY'
import json, subprocess, sys, os
state = sys.argv[1]
clients = json.loads(subprocess.check_output(['hyprctl','clients','-j'], text=True))
protected = [c['address'] for c in clients if c.get('floating')]
os.makedirs(os.path.dirname(state), exist_ok=True)
with open(state,'w') as f: f.write('\n'.join(protected))
n = 0
for c in clients:
    # skip unmapped and TRUE fullscreen (fs=1); maximized (fs=2) is convertible
    if not c.get('mapped') or c.get('floating') or c.get('fullscreen', 0) == 1: continue
    if str(c.get('workspace',{}).get('name','')).startswith('special'): continue
    subprocess.run(['hyprctl','eval',
        'hl.dispatch(hl.dsp.window.float({ action = "on", window = "address:%s" }))' % c['address']],
        stdout=subprocess.DEVNULL)
    n += 1
print(f"floated {n}, protected {len(protected)}")
PY
}

# Float -> tile: un-float every floating window that is not protected and
# not on a special workspace. Fullscreen windows are left alone.
sweep_to_tile() {
  export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(find_hyprland_sig)}"
  python3 - "$PROTECTED" <<'PY'
import json, subprocess, sys, os
state = sys.argv[1]
protected = set()
if os.path.exists(state):
    with open(state) as f: protected = {l.strip() for l in f if l.strip()}
clients = json.loads(subprocess.check_output(['hyprctl','clients','-j'], text=True))
n = 0
for c in clients:
    # skip unmapped and TRUE fullscreen (fs=1); maximized (fs=2) is convertible
    if not c.get('mapped') or not c.get('floating') or c.get('fullscreen', 0) == 1: continue
    if c['address'] in protected: continue
    if str(c.get('workspace',{}).get('name','')).startswith('special'): continue
    subprocess.run(['hyprctl','eval',
        'hl.dispatch(hl.dsp.window.float({ action = "off", window = "address:%s" }))' % c['address']],
        stdout=subprocess.DEVNULL)
    n += 1
if os.path.exists(state): os.remove(state)
print(f"tiled {n}, kept floating {len(protected)}")
PY
}

apply_float() {
  mkdir -p "$TOGGLE_DIR"
  cat > "$FLOAT_FLAG" <<'EOF'
-- sammypro5: float-all mode for ultrawide docked use
o.window(".*", { float = true })
EOF
  rm -f "$ASPECT_FLAG"
}

apply_tile() {
  rm -f "$FLOAT_FLAG"
  # Copy Omarchy's stock aspect flag (same as Super+Ctrl+Backspace toggle)
  cp "${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr/toggles/single-window-aspect-ratio.lua" "$ASPECT_FLAG" 2>/dev/null || {
    mkdir -p "$TOGGLE_DIR"
    cat > "$ASPECT_FLAG" <<'EOF'
hl.config({
  layout = {
    single_window_aspect_ratio = { 1, 1 },
  },
})
EOF
  }
}

apply_off() {
  rm -f "$FLOAT_FLAG" "$ASPECT_FLAG"
}

case "${1:-toggle}" in
  float)  apply_float;  hyprctl reload >/dev/null; sweep_to_float
          # optional bar width as 2nd arg (daemon exec is shellwords-split,
          # so this is how the profile passes both mode and width)
          if [[ -n ${2:-} && -x $(command -v ultrawide-bar-width 2>/dev/null || true) ]]; then
            ultrawide-bar-width "$2" >/dev/null 2>&1 || true
          fi
          notify "floating" ;;
  tile)   apply_tile;   hyprctl reload >/dev/null; sweep_to_tile
          [[ -n ${2:-} ]] && ultrawide-bar-width "$2" >/dev/null 2>&1 || true
          notify "tiled + 1:1 aspect" ;;
  off)    apply_off;    hyprctl reload >/dev/null; sweep_to_tile
          [[ -n ${2:-} ]] && ultrawide-bar-width "$2" >/dev/null 2>&1 || true
          notify "dwindle (default)" ;;
  status)
    if [[ -f $FLOAT_FLAG ]]; then echo "float"
    elif [[ -f $ASPECT_FLAG ]]; then echo "tile"
    else echo "off"; fi
    ;;
  toggle)
    case $(ultrawide-mode status) in
      float) ultrawide-mode tile ;;
      *)     ultrawide-mode float ;;
    esac
    ;;
  *) echo "Usage: ultrawide-mode [float|tile|off|status|toggle]" >&2; exit 1 ;;
esac
